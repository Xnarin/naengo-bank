# .env 로 복사한 뒤 값을 채우세요. .env 는 커밋하지 마세요.
DATABASE_URL=postgresql+psycopg://postgres:<비밀번호>@localhost:5432/bank
JWT_SECRET=<긴 랜덤 문자열: python -c "import secrets; print(secrets.token_urlsafe(48))">

# Docker 실행 시 루트 .env.docker를 사용합니다. 이 파일은 로컬 Python 실행용입니다.
DEVELOPMENT=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CARD_KEY=
SCHEDULER_ENABLED=false
